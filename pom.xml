<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.openmrs.maven.parents</groupId>
		<artifactId>maven-parent-openmrs-module</artifactId>
		<version>2.3.0</version>
		<relativePath/>
	</parent>

	<groupId>org.openmrs.module</groupId>
	<artifactId>chwsync</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>CHW Sync</name>
	<description>
		Community Health Worker module for OpenMRS. Provides an offline-first, delta-sync
		REST API over the core patient/encounter/visit schema plus module tables for
		households, appointments and referrals, and serves a lightweight progressive web
		app that runs on Android phones and tablets.
	</description>

	<organization>
		<name>OpenMRS</name>
		<url>https://openmrs.org</url>
	</organization>

	<properties>
		<openmrsPlatformVersion>2.8.9</openmrsPlatformVersion>
		<openmrsPlatformToolsVersion>${openmrsPlatformVersion}</openmrsPlatformToolsVersion>
		<!-- OpenMRS 2.5+ requires Java 11; 11 keeps the module loadable on any 2.x server. -->
		<maven.compiler.release>11</maven.compiler.release>
		<jacksonVersion>2.13.5</jacksonVersion>
		<commonsLang3Version>3.12.0</commonsLang3Version>
		<openmrsMavenPluginVersion>1.0.1</openmrsMavenPluginVersion>
	</properties>

	<modules>
		<module>api</module>
		<module>omod</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-lang3</artifactId>
				<version>${commonsLang3Version}</version>
				<scope>provided</scope>
			</dependency>

			<dependency>
				<groupId>org.openmrs.api</groupId>
				<artifactId>openmrs-api</artifactId>
				<version>${openmrsPlatformVersion}</version>
				<type>test-jar</type>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.openmrs.web</groupId>
				<artifactId>openmrs-web</artifactId>
				<version>${openmrsPlatformVersion}</version>
				<type>test-jar</type>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.openmrs.maven.plugins</groupId>
					<artifactId>maven-openmrs-plugin</artifactId>
					<version>${openmrsMavenPluginVersion}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>
