<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

	<!--
		The change log is the sync feed's backbone: one append-only row per change anyone made, anywhere.
		It stores no payload on purpose - a pull reads the record fresh - so its cost is one narrow insert
		per write and one ordered scan per pull. Every changeset is guarded with a tableExists precondition
		so a re-run on a database that already has the table does nothing rather than failing module start.
	-->

	<changeSet id="chwsync-01-sync-change" author="chwsync">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="chwsync_change"/>
			</not>
		</preConditions>
		<createTable tableName="chwsync_change" remarks="Append-only log of every change that belongs on the sync feed">
			<column name="change_id" type="bigint" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="chwsync_change_pk"/>
			</column>
			<column name="entity_type" type="varchar(32)">
				<constraints nullable="false"/>
			</column>
			<column name="entity_uuid" type="varchar(38)">
				<constraints nullable="false"/>
			</column>
			<column name="operation" type="varchar(16)">
				<constraints nullable="false"/>
			</column>
			<column name="changed_at" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="changed_by_id" type="int"/>
			<column name="origin_device_uuid" type="varchar(38)"/>
			<column name="client_change_id" type="varchar(64)"/>
		</createTable>
		<!--
			The pull reads "changed_at > cursor, ordered by changed_at". This index is what keeps that a
			range scan instead of a sort of the whole log, which matters once the log has run for a while.
		-->
		<createIndex tableName="chwsync_change" indexName="chwsync_change_changed_at_idx">
			<column name="changed_at"/>
		</createIndex>
	</changeSet>

	<changeSet id="chwsync-02-client-change" author="chwsync">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="chwsync_client_change"/>
			</not>
		</preConditions>
		<createTable tableName="chwsync_client_change"
			remarks="Outcome of each client change, keyed by the client's own id, so a retried push is not applied twice">
			<column name="client_change_id" type="varchar(64)">
				<constraints primaryKey="true" primaryKeyName="chwsync_client_change_pk"/>
			</column>
			<column name="device_uuid" type="varchar(38)"/>
			<column name="result_json" type="text"/>
			<column name="processed_at" type="datetime">
				<constraints nullable="false"/>
			</column>
		</createTable>
	</changeSet>

	<changeSet id="chwsync-03-device" author="chwsync">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="chwsync_device"/>
			</not>
		</preConditions>
		<createTable tableName="chwsync_device" remarks="A phone or tablet a CHW syncs from">
			<column name="device_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="chwsync_device_pk"/>
			</column>
			<column name="uuid" type="varchar(38)">
				<constraints nullable="false" unique="true" uniqueConstraintName="chwsync_device_uuid_uk"/>
			</column>
			<column name="user_id" type="int"/>
			<column name="name" type="varchar(120)"/>
			<column name="platform" type="varchar(40)"/>
			<column name="app_version" type="varchar(40)"/>
			<column name="active" type="boolean" defaultValueBoolean="true">
				<constraints nullable="false"/>
			</column>
			<column name="date_created" type="datetime"/>
			<column name="last_seen" type="datetime"/>
		</createTable>
		<createIndex tableName="chwsync_device" indexName="chwsync_device_user_idx">
			<column name="user_id"/>
		</createIndex>
	</changeSet>

	<changeSet id="chwsync-04-client-token" author="chwsync">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="chwsync_client_token"/>
			</not>
		</preConditions>
		<createTable tableName="chwsync_client_token"
			remarks="Bearer tokens issued to devices. Only the SHA-256 hash is stored; the token itself is shown once">
			<column name="token_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="chwsync_client_token_pk"/>
			</column>
			<column name="token_hash" type="varchar(64)">
				<constraints nullable="false" unique="true" uniqueConstraintName="chwsync_client_token_hash_uk"/>
			</column>
			<column name="user_id" type="int"/>
			<column name="device_uuid" type="varchar(38)"/>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="date_expires" type="datetime"/>
			<column name="last_used" type="datetime"/>
			<column name="revoked" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<createIndex tableName="chwsync_client_token" indexName="chwsync_client_token_device_idx">
			<column name="device_uuid"/>
		</createIndex>
	</changeSet>

	<changeSet id="chwsync-05-household" author="chwsync">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="chwsync_household"/>
			</not>
		</preConditions>
		<createTable tableName="chwsync_household" remarks="A household, the group a community health worker visits">
			<column name="household_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="chwsync_household_pk"/>
			</column>
			<column name="uuid" type="varchar(38)">
				<constraints nullable="false" unique="true" uniqueConstraintName="chwsync_household_uuid_uk"/>
			</column>
			<column name="name" type="varchar(255)">
				<constraints nullable="false"/>
			</column>
			<column name="location_id" type="int"/>
			<column name="head_patient_id" type="int"/>
			<column name="village" type="varchar(255)"/>
			<column name="creator" type="int"/>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="changed_by" type="int"/>
			<column name="date_changed" type="datetime"/>
			<column name="voided" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="voided_by" type="int"/>
			<column name="date_voided" type="datetime"/>
			<column name="void_reason" type="varchar(255)"/>
		</createTable>
	</changeSet>

	<changeSet id="chwsync-06-household-member" author="chwsync">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="chwsync_household_member"/>
			</not>
		</preConditions>
		<createTable tableName="chwsync_household_member" remarks="Membership of a patient in a household">
			<column name="id" type="int" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="chwsync_household_member_pk"/>
			</column>
			<column name="household_id" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="patient_id" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="relationship" type="varchar(64)"/>
			<column name="head_of_household" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="date_changed" type="datetime"/>
			<column name="voided" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
		</createTable>
		<createIndex tableName="chwsync_household_member" indexName="chwsync_household_member_household_idx">
			<column name="household_id"/>
		</createIndex>
		<createIndex tableName="chwsync_household_member" indexName="chwsync_household_member_patient_idx">
			<column name="patient_id"/>
		</createIndex>
	</changeSet>

	<changeSet id="chwsync-07-appointment" author="chwsync">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="chwsync_appointment"/>
			</not>
		</preConditions>
		<createTable tableName="chwsync_appointment" remarks="A follow-up a CHW has scheduled">
			<column name="appointment_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="chwsync_appointment_pk"/>
			</column>
			<column name="uuid" type="varchar(38)">
				<constraints nullable="false" unique="true" uniqueConstraintName="chwsync_appointment_uuid_uk"/>
			</column>
			<column name="patient_id" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="provider_id" type="int"/>
			<column name="location_id" type="int"/>
			<column name="appointment_date" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="reason" type="varchar(255)"/>
			<column name="status" type="varchar(32)">
				<constraints nullable="false"/>
			</column>
			<column name="notes" type="text"/>
			<column name="creator" type="int"/>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="changed_by" type="int"/>
			<column name="date_changed" type="datetime"/>
			<column name="voided" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="voided_by" type="int"/>
			<column name="date_voided" type="datetime"/>
			<column name="void_reason" type="varchar(255)"/>
		</createTable>
		<createIndex tableName="chwsync_appointment" indexName="chwsync_appointment_patient_idx">
			<column name="patient_id"/>
		</createIndex>
		<createIndex tableName="chwsync_appointment" indexName="chwsync_appointment_date_idx">
			<column name="appointment_date"/>
		</createIndex>
	</changeSet>

	<changeSet id="chwsync-08-referral" author="chwsync">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="chwsync_referral"/>
			</not>
		</preConditions>
		<createTable tableName="chwsync_referral" remarks="A referral from a CHW out to a facility">
			<column name="referral_id" type="int" autoIncrement="true">
				<constraints primaryKey="true" primaryKeyName="chwsync_referral_pk"/>
			</column>
			<column name="uuid" type="varchar(38)">
				<constraints nullable="false" unique="true" uniqueConstraintName="chwsync_referral_uuid_uk"/>
			</column>
			<column name="patient_id" type="int">
				<constraints nullable="false"/>
			</column>
			<column name="referral_date" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="facility" type="varchar(255)"/>
			<column name="reason" type="varchar(255)"/>
			<column name="urgency" type="varchar(32)"/>
			<column name="status" type="varchar(32)">
				<constraints nullable="false"/>
			</column>
			<column name="notes" type="text"/>
			<column name="creator" type="int"/>
			<column name="date_created" type="datetime">
				<constraints nullable="false"/>
			</column>
			<column name="changed_by" type="int"/>
			<column name="date_changed" type="datetime"/>
			<column name="voided" type="boolean" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="voided_by" type="int"/>
			<column name="date_voided" type="datetime"/>
			<column name="void_reason" type="varchar(255)"/>
		</createTable>
		<createIndex tableName="chwsync_referral" indexName="chwsync_referral_patient_idx">
			<column name="patient_id"/>
		</createIndex>
		<createIndex tableName="chwsync_referral" indexName="chwsync_referral_date_idx">
			<column name="referral_date"/>
		</createIndex>
	</changeSet>

</databaseChangeLog>
